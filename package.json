{
  "name": "agent-compositor",
  "version": "0.7.4",
  "private": true,
  "type": "module",
  "description": "Open runtime for LLM CLI agents: core, swappable renderers, plugin contracts.",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "website"
  ],
  "scripts": {
    "docs:dev": "node tools/docs/dev.mjs",
    "docs:build": "npm run build -w @agent-compositor/docs",
    "docs:serve": "npm run serve -w @agent-compositor/docs",
    "docs:check": "node tools/docs/check.mjs && node --import tsx --test tools/docs/examples.check.mjs && npm run docs:build",
    "docs:gen": "node tools/docs/generate.mjs",
    "docs:impact": "node tools/docs/impact.mjs",
    "docs:browser": "node tools/docs/browser-check.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b --emitDeclarationOnly false --noEmit && tsc -p tools/plugins/tsconfig.json && tsc -p tools/evals/tsconfig.json",
    "gen": "npm run gen --workspaces --if-present",
    "example:headless": "tsx examples/headless-core.ts",
    "example:loader": "tsx examples/loader-demo.ts",
    "example:ink": "tsx examples/ink-demo.ts",
    "install:defaults": "node -e \"fs.cpSync('plugins', require('os').homedir() + '/.agent-compositor/plugins', {recursive: true})\"",
    "visual:serve": "bun tools/visual/server.mjs",
    "visual:performance": "node tools/visual/performance-check.mjs",
    "visual:check": "node tools/visual/check.mjs",
    "eval": "bun tools/evals/run.ts",
    "eval:ollama": "bun tools/evals/run.ts --models gemma4:31b-cloud,deepseek-v4.1-flash:1017-cloud",
    "harness2:check": "python3 tools/evals/harness2_adapter.py --check",
    "marketplace:validate": "bun tools/marketplace/validate.ts",
    "eval:proxy": "bun tools/evals/proxy-smoke.ts",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=reports/junit.xml",
    "build:release": "bun tools/release/build.mjs",
    "release:smoke": "bun tools/release/smoke.mjs",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased",
    "visual:mascot": "node tools/visual/mascot-check.mjs",
    "visual:settings": "node tools/visual/settings-check.mjs",
    "eval:agent": "bun tools/evals/run.ts --suite tools/evals/agent-cases.json",
    "visual:workflows": "node tools/visual/workflow-check.mjs",
    "test:callix": "node tools/evals/callix-test.mjs",
    "eval:navigation": "bun tools/evals/navigation-bench.ts",
    "eval:navigation:live": "bun tools/evals/navigation-live.ts",
    "eval:tools": "bun tools/evals/run.ts --suite tools/evals/tool-cases.json",
    "visual:presentation": "node tools/visual/presentation-check.mjs",
    "visual:questions": "node tools/visual/questions-check.mjs",
    "visual:history": "node tools/visual/history-check.mjs",
    "visual:ux": "node tools/visual/ux-check.mjs",
    "visual:controllers": "node tools/visual/controllers-check.mjs",
    "visual:workspaces": "node tools/visual/workspaces-check.mjs",
    "visual:background": "node tools/visual/background-check.mjs",
    "eval:harness2": "python3 tools/evals/harness2_bench.py",
    "test:harness2": "python3 -m pytest -c tools/evals/tests/pytest.ini",
    "visual:author": "node tools/visual/author-check.mjs",
    "plugin:check": "bun tools/plugins/check.ts",
    "plugin:test": "bun tools/plugins/test.mjs",
    "plugin:build": "bun tools/plugins/build.mjs",
    "plugin:smoke": "bun tools/plugins/smoke.ts",
    "plugin:changed": "bun tools/plugins/changed.mjs",
    "plugin:prepare": "bun tools/plugins/release-plan.mjs",
    "plugin:schema": "bun tools/plugins/schema.ts",
    "visual:marketplace": "node tools/visual/marketplace-check.mjs",
    "plugin:test:all": "bun tools/plugins/all.mjs",
    "plugin:catalog": "bun tools/plugins/catalog-update.ts",
    "plugin:audit": "bun tools/plugins/certify.ts --all --audit",
    "plugin:certify": "bun tools/plugins/certify.ts",
    "plugin:gate": "bun tools/plugins/gate.ts"
  },
  "overrides": {
    "@docusaurus/core": { "tinypool": "^2.2.0" },
    "serialize-javascript": "^7.1.4",
    "sockjs": { "uuid": "^11.1.1" }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/upng-js": "^2.1.5",
    "@vitest/coverage-v8": "^5.1.0",
    "@xterm/xterm": "^6.0.0",
    "git-cliff": "2.14.2",
    "playwright": "^1.65.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7",
    "@types/omggif": "^1.0.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
