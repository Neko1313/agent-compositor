{
  "name": "agent-compositor",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Open runtime for LLM CLI agents: core, swappable renderers, plugin contracts.",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b --emitDeclarationOnly false --noEmit",
    "gen": "npm run gen --workspaces --if-present",
    "example:headless": "tsx examples/headless-core.ts",
    "example:loader": "tsx examples/loader-demo.ts",
    "example:ink": "tsx examples/ink-demo.ts",
    "install:defaults": "node -e \"fs.cpSync('plugins', require('os').homedir() + '/.agent-compositor/plugins', {recursive: true})\"",
    "visual:serve": "bun tools/visual/server.mjs",
    "visual:check": "node tools/visual/check.mjs",
    "eval": "bun tools/evals/run.ts",
    "eval:ollama": "bun tools/evals/run.ts --models gemma4:31b-cloud,deepseek-v4.1-flash:1017-cloud",
    "harness2:check": "python3 tools/evals/harness2_adapter.py --check",
    "marketplace:validate": "bun tools/marketplace/validate.ts",
    "eval:proxy": "bun tools/evals/proxy-smoke.ts",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit --outputFile=reports/junit.xml",
    "build:release": "bun tools/release/build.mjs",
    "release:smoke": "bun tools/release/smoke.mjs",
    "changelog": "git-cliff --output CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased",
    "visual:mascot": "node tools/visual/mascot-check.mjs",
    "visual:settings": "node tools/visual/settings-check.mjs",
    "eval:agent": "bun tools/evals/run.ts --suite tools/evals/agent-cases.json",
    "visual:workflows": "node tools/visual/workflow-check.mjs",
    "test:callix": "node tools/evals/callix-test.mjs",
    "eval:navigation": "bun tools/evals/navigation-bench.ts",
    "eval:navigation:live": "bun tools/evals/navigation-live.ts",
    "eval:tools": "bun tools/evals/run.ts --suite tools/evals/tool-cases.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/upng-js": "^2.1.5",
    "@vitest/coverage-v8": "^5.1.0",
    "@xterm/xterm": "^6.0.0",
    "git-cliff": "2.14.2",
    "playwright": "^1.65.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
