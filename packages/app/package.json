{
  "name": "@agent-compositor/app",
  "version": "0.1.0",
  "description": "The assembled agent: config \u2192 provider \u2192 disk plugins \u2192 session store \u2192 REPL. This is the sway-analog entrypoint the libraries exist for.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "compositor": "./src/bin.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:binary": "bun build --compile src/bin.ts --outfile ../../dist/compositor",
    "start": "bun src/bin.ts"
  },
  "dependencies": {
    "@agent-compositor/cli": "^0.1.0",
    "@agent-compositor/config": "^0.1.0",
    "@agent-compositor/core": "^0.1.0",
    "@agent-compositor/plugins": "^0.1.0",
    "@agent-compositor/provider": "^0.1.0",
    "@agent-compositor/session": "^0.1.0"
  }
}
