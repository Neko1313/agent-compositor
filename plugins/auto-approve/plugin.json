{
  "name": "auto-approve",
  "version": "1.3.1",
  "trust": "trusted",
  "description": "Opt-in task-context review for console, plugin, MCP and workflow actions, with structured approval/refusal/uncertainty and binding host denies.",
  "provides": [
    "service.permission.review"
  ],
  "hookTimeouts": {
    "service.permission.review": 20000
  },
  "commands": [
    {
      "name": "/auto",
      "execution": "immediate",
      "description": "Configure automatic risk review",
      "usage": "/auto on|off|status|history"
    }
  ],
  "compositor": {
    "standard": 1,
    "apiVersion": 1
  }
}
