{
  "name": "cost",
  "version": "1.3.0",
  "description": "/cost and /usage — token accounting from turn.usage events (Claude Code /cost analog). Tally survives across turns in plugin state; drop this folder to remove.",
  "trust": "trusted",
  "capabilities": [
    "turn.usage",
    "prompt.submit"
  ],
  "commands": [
    {
      "name": "/cost",
      "description": "Show token costs",
      "ui": {
        "site": "usage"
      }
    },
    {
      "name": "/usage",
      "description": "Show token usage",
      "ui": {
        "site": "usage"
      }
    }
  ],
  "compositor": {
    "standard": 1,
    "apiVersion": 1
  }
}
