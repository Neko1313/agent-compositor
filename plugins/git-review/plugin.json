{
  "name": "git-review",
  "version": "0.1.0",
  "description": "Review Git status and staged or working diffs through a read-only tool and interactive panel.",
  "trust": "trusted",
  "compositor": {
    "standard": 1,
    "apiVersion": 1
  },
  "commands": [
    {
      "name": "/git-review",
      "description": "Review Git status and changes",
      "ui": {"site": "main"}
    }
  ],
  "main": "hooks.ts",
  "hookTimeouts": {
    "ui.press": 300000
  }
}
