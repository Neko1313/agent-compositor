{
  "name": "network-proxy",
  "version": "1.2.0",
  "trust": "trusted",
  "description": "Optional HTTP CONNECT proxy for model streams and network tools, with child-process proxy environment.",
  "commands": [
    {
      "name": "/proxy",
      "description": "Configure network proxy",
      "usage": "/proxy [configure|status|on|off]",
      "ui": {
        "site": "network"
      }
    }
  ],
  "hookTimeouts": {
    "prompt.submit": 300000,
    "ui.press": 300000
  },
  "compositor": {
    "standard": 1,
    "apiVersion": 1
  }
}
