    "ui.invalidate": {
      "since": "0.1.0",
      "version": 1,
      "summary": "Damage tracking: the plugin marks changed regions of its pane.",
      "namespace": "ui",
      "generator": false,
      "aliases": [],
      "frozen": true,
      "input": {
        "note": "opaque"
      },
      "responses": {}
