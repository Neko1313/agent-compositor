    "ui.focus": {
      "since": "0.1.0",
      "version": 1,
      "summary": "Focus is about to move to another pane/control.",
      "namespace": "ui",
      "generator": false,
      "aliases": [],
      "frozen": true,
      "input": {
        "note": "opaque"
      },
      "responses": {
        "next": {
          "summary": "proceed",
          "schema": {
            "note": "opaque"
          }
