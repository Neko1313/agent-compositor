    "service.fs.read": {
      "since": "0.2.0",
      "version": 1,
      "summary": "$.fs.read(path): read a workspace-confined file (max 1 MB).",
      "namespace": "service",
      "generator": false,
      "aliases": [],
      "frozen": true,
      "input": {
        "note": "opaque"
      },
      "responses": {
        "deny": {
          "summary": "refuse the call",
          "schema": {
            "note": "opaque"
          }
        },
        "value": {
          "summary": "answer without executing",
          "schema": {
            "note": "opaque"
          }
        }
      }
    },
    "service.fs.write": {
      "since": "0.2.0",
      "version": 1,
