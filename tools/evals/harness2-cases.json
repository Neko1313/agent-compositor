  {
    "id": "redirect-boundary",
    "split": "test",
    "domain": "web",
    "prompt": "Fetch {{origin}}/redirect once. Do not follow a redirect; report that the target needs its own approval.",
    "files": {},
    "script": [
      {
        "calls": [
          {
            "name": "web_fetch",
            "args": {
              "url": "{{origin}}/redirect"
            }
          }
        ]
      },
      {
        "text": "The redirect target needs its own approval.",
        "requires": [
          "Redirect requires a new approved fetch"
        ]
      }
    ],
    "expect": {
      "tools": [
        {
          "tool": "web_fetch",
          "ok": false,
          "errorIncludes": [
            "Redirect requires a new approved fetch"
          ]
        }
      ],
      "httpPaths": [
        "/redirect"
      ],
      "noHttpPaths": [
        "/hidden"
      ],
      "maxToolCalls": 1
    },
    "http": {
      "/redirect": {
        "status": 302,
        "body": "",
        "headers": {
          "Location": "/hidden"
        }
      },
      "/hidden": {
        "type": "text/plain",
        "body": "REDIRECT_PRIVATE_6845"
      }
    }
  },
