[
  {
    "id": "read-evidence",
    "split": "train",
    "domain": "evidence",
    "prompt": "Read facts.txt and report the deployment region.",
    "files": {
      "facts.txt": "Deployment region: ap-northeast-3\n"
    },
    "script": [
      {
        "calls": [
          {
            "name": "read",
            "args": {
              "path": "facts.txt"
            }
          }
        ]
      },
      {
        "text": "The deployment region is ap-northeast-3.",
        "requires": [
          "ap-northeast-3"
        ]
      }
    ],
    "expect": {
      "tools": [
        {
          "tool": [
            "read",
            "exec"
          ],
          "ok": true,
          "outputIncludes": [
            "ap-northeast-3"
          ]
        }
      ],
      "responseIncludes": [
        "ap-northeast-3"
      ],
      "maxToolCalls": 2
    }
  },
  {
    "id": "quoted-home-project",
